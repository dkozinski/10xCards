---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ReviewSession from "@/components/review/ReviewSession";
import { countFlashcards } from "@/lib/services/flashcards";
import { createClient } from "@/lib/supabase";

// Only the deck size is loaded here; the island fetches every card itself, so
// no card text is serialized into the page and a card deleted elsewhere is never shown.
let total = 0;
let loadFailed = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  try {
    total = await countFlashcards(supabase);
  } catch (error) {
    const { code, message } = error as { code?: string; message?: string };
    // eslint-disable-next-line no-console
    console.error("countFlashcards failed", { code, message });
    loadFailed = true;
  }
} else {
  loadFailed = true;
}
---

<Layout title="Review">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-2xl text-white">
      <Topbar />

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Review
        </h1>

        {
          loadFailed ? (
            <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
              Your deck could not be loaded. Refresh the page to try again.
            </p>
          ) : total === 0 ? (
            <p class="text-blue-100/80">
              Your deck is empty — add cards{" "}
              <a href="/deck" class="text-purple-300 hover:text-purple-100 hover:underline">
                by hand
              </a>{" "}
              or{" "}
              <a href="/generate" class="text-purple-300 hover:text-purple-100 hover:underline">
                generate them with AI
              </a>
              .
            </p>
          ) : (
            <ReviewSession client:load />
          )
        }
      </section>
    </div>
  </div>
</Layout>
