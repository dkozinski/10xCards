---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import DeleteAccount from "@/components/account/DeleteAccount";

// The middleware guards this route, so a user is always present here; the email
// is the one getUser() validated with the Auth server on this request.
const email = Astro.locals.user?.email ?? "";
---

<Layout title="Account">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-2xl text-white">
      <Topbar />

      <section class="mb-6 rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Account
        </h1>
        <p class="text-sm text-blue-100/80">
          Signed in as <span class="font-medium text-white">{email}</span>
        </p>
      </section>

      <section class="rounded-2xl border border-red-500/30 bg-red-950/20 p-6 backdrop-blur-xl">
        <h2 class="mb-2 text-xl font-semibold text-red-200">Danger zone</h2>
        <p class="mb-2 text-sm text-blue-100/80">
          Deleting your account removes it together with all of its data: your flashcards, your generation history and
          your review history.
        </p>
        <p class="mb-4 text-sm font-medium text-red-200">This cannot be undone.</p>
        <DeleteAccount client:load email={email} />
      </section>
    </div>
  </div>
</Layout>
